{
  "name": "ppp-apiclinicaveterinaria",
  "version": "1.0.0",
  "description": "API REST para gerenciamento de Clínica Veterinária",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon --watch src --exec node src/app.js",
    "test": "mocha tests/supertest/integration/*.test.js",
    "test:watch": "mocha tests/supertest/integration/*.test.js --watch",
    "test:auth": "mocha tests/supertest/integration/auth.test.js",
    "test:pets": "mocha tests/supertest/integration/pets.test.js",
    "test:consultas": "mocha tests/supertest/integration/consultas-procedimentos.test.js",
    "test:k6": "k6 run tests/k6/auth.test.js && k6 run tests/k6/pets.test.js && k6 run tests/k6/consultas.test.js && k6 run tests/k6/procedimentos.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnaCRRossi/ppp-apiclinicaveterinaria.git"
  },
  "keywords": [
    "api",
    "veterinaria",
    "node",
    "express"
  ],
  "author": "Ana Carolina Ragghianti de Rossi",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AnaCRRossi/ppp-apiclinicaveterinaria/issues"
  },
  "homepage": "https://github.com/AnaCRRossi/ppp-apiclinicaveterinaria#readme",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^4.6.3",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "chai-http": "^4.4.0",
    "mocha": "^11.7.4",
    "nodemon": "^2.0.22",
    "supertest": "^7.1.4"
  }
}
